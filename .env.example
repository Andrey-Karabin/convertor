BOT_TOKEN=
MAX_INPUT_MB=200
MAX_OUTPUT_MB=49
DJVU_PDF_QUALITY=printer
DJVU_PDF_KEEP_RESOLUTION=true
DJVU_CONVERT_WORKERS=4
DJVU_AUTO_ORIENT_PAGES=true
DJVU_AUTO_ORIENT_MODE=landscape
DJVU_AUTO_ORIENT_WORKERS=4
DJVU_AUTO_ORIENT_DPI=110
DJVU_AUTO_ORIENT_MIN_CONFIDENCE=1.0
WORKDIR=/tmp/convertor
DB_PATH=/tmp/convertor/bot.sqlite3
DOCKER_CPUS=4

# Optional admin panel and weekly user limits.
# ADMIN_IDS is a comma-separated list of numeric Telegram user ids.
ADMIN_IDS=
# 0 means disabled.
WEEKLY_LIMIT_FILES=0
WEEKLY_LIMIT_MB=0

# Compression.
IMAGE_COMPRESS_QUALITY=75
IMAGE_COMPRESS_MAX_SIDE=1600
PDF_COMPRESS_QUALITY=ebook

# Archive extraction safety limits.
ARCHIVE_MAX_OUTPUT_MB=500
ARCHIVE_MAX_FILES=200

# Optional Streamlit web converter.
STREAMLIT_PORT=8501
STREAMLIT_MAX_UPLOAD_MB=500
# If WEB_PASSWORD is empty, the web app is open to anyone who can reach the port.
WEB_PASSWORD=

# Optional: enable self-hosted Telegram Bot API server for files up to 2000 MB.
# Get TELEGRAM_API_ID and TELEGRAM_API_HASH at https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE=
TELEGRAM_API_IS_LOCAL=false
TELEGRAM_REQUEST_TIMEOUT=3600
