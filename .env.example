# ---- Required -------------------------------------------------------------
BOT_TOKEN=
# Numeric Telegram ids of admins, comma separated (get yours from @userinfobot).
ADMIN_IDS=

# ---- Limits and payments (Telegram Stars) ---------------------------------
# false = everything free and unlimited.
BILLING_ENABLED=true
# Free operations per user per week (1 operation = 1 input file).
FREE_WEEKLY_OPS=20
# What can be bought: kind:amount:stars, comma separated.
#   credits:50:25  -> 50 operations for 25 Stars
#   premium:30:150 -> unlimited for 30 days for 150 Stars
PRODUCTS=credits:50:25,credits:200:90,credits:1000:400,premium:30:150
# Shown in /paysupport, e.g. @your_username
SUPPORT_CONTACT=

# ---- Queue ----------------------------------------------------------------
# How many jobs run at the same time (each can use several CPU cores).
QUEUE_WORKERS=2
# How many jobs one user may have queued/running at once.
USER_MAX_JOBS=3
# CPU cores the bot container may use.
DOCKER_CPUS=4

# ---- OCR (text recognition in every PDF) ----------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
# CPU cores per OCR job.
OCR_JOBS=2
# Turn sideways scanned pages upright.
OCR_ROTATE_PAGES=true
OCR_TIMEOUT=3600

# ---- Files ----------------------------------------------------------------
# With the public Bot API Telegram allows bots to download only 20 MB and upload 50 MB.
# Bigger limits work only with the local Bot API server (see below).
MAX_INPUT_MB=200
MAX_OUTPUT_MB=49

# ---- Conversion -----------------------------------------------------------
DJVU_PDF_QUALITY=printer
DJVU_PDF_KEEP_RESOLUTION=true
DJVU_CONVERT_WORKERS=4
IMAGE_COMPRESS_QUALITY=75
IMAGE_COMPRESS_MAX_SIDE=1600
PDF_COMPRESS_QUALITY=ebook
ARCHIVE_MAX_OUTPUT_MB=500
ARCHIVE_MAX_FILES=200
TOOL_TIMEOUT=1800

# ---- Optional: local Bot API server (files up to 2000 MB) -----------------
# Get API id/hash at https://my.telegram.org, then uncomment all lines below.
# COMPOSE_PROFILES=local-api
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
# TELEGRAM_API_IS_LOCAL=true
# MAX_OUTPUT_MB=2000
TELEGRAM_REQUEST_TIMEOUT=3600
